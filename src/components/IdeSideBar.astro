<script>
  // Add resizer logic - wrapped in astro:page-load so it persists across view transitions
  document.addEventListener("astro:page-load", () => {
    const sidebar = document.getElementById('ide-sidebar');
    const resizer = document.getElementById('sidebar-resizer');
    
    if (sidebar && resizer) {
      let isResizing = false;
      
      // Load saved width from localStorage if it exists
      const savedWidth = localStorage.getItem('ide-sidebar-width');
      if (savedWidth) {
        sidebar.style.width = savedWidth;
      }
      
      resizer.addEventListener('mousedown', (e) => {
        isResizing = true;
        document.body.style.cursor = 'col-resize';
        sidebar.style.userSelect = 'none';
        sidebar.style.transition = 'none'; // disable transitions while dragging
        e.preventDefault();
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isResizing) return;
        // limit the width between 160px and 800px
        const newWidth = Math.min(Math.max(e.clientX, 160), 800);
        sidebar.style.width = `${newWidth}px`;
      });
      
      document.addEventListener('mouseup', () => {
        if (isResizing) {
          isResizing = false;
          document.body.style.cursor = '';
          sidebar.style.userSelect = '';
          // Save the width to localStorage so it persists on reload
          localStorage.setItem('ide-sidebar-width', sidebar.style.width);
        }
      });
    }
  });
</script>